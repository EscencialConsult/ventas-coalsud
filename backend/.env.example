# Copiar a .env (nunca se commitea). Ver docs/04-ejecucion/Entornos_y_Despliegue.md §2.
# En local no hace falta nada: `npm run db:start` imprime las claves de la base de Docker.

# Proyecto vinculado (dev o prod) para `supabase link` / `npm run db:push`
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Solo para scripts de carga (scripts/carga-inicial). SECRETO: nunca en el repo ni en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
