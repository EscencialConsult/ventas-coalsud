{
  "name": "coalsud-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:remoto": "node scripts/test-remoto.mjs",
    "db:concurrencia": "node scripts/concurrencia.mjs",
    "db:rendimiento": "node -e \"process.exit(require('node:child_process').spawnSync('psql', [process.env.SUPABASE_DB_URL, '-X', '-f', 'scripts/rendimiento.sql'], { stdio: 'inherit' }).status)\"",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push --linked",
    "types": "node scripts/gen-types.mjs",
    "fn:serve": "supabase functions serve admin-usuarios",
    "fn:deploy": "supabase functions deploy admin-usuarios"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "supabase": "^2.122.0"
  }
}
