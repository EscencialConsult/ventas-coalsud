# fixtures = datos de ejemplo en memoria (no hace falta Supabase) · supabase = backend real
# Si no se define: fixtures en desarrollo, supabase en build de producción.
VITE_MODO_DATOS=fixtures

# Solo con VITE_MODO_DATOS=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cierre de sesión por inactividad (⚠ SUP-38)
VITE_INACTIVIDAD_MIN=30
